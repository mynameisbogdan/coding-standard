{
    "name": "mnib-dev/coding-standard",
    "type": "phpcodesniffer-standard",
    "description": "Personal coding standards heavily based on Doctrine Coding Standard.",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.6.2 || ^0.7 || ^1.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "slevomat/coding-standard": "^6.3 || ^7.0 || ^8.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.4"
    },
    "autoload": {
        "psr-4": {
            "MNIB\\CsFixer\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    }
}
